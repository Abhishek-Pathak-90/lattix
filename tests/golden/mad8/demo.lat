! lattix <version> from IR

BEAM, PARTICLE=PROTON, MASS=0.93827208816, CHARGE=1, ENERGY=1.73827208816

! --- parameters
BRHO := 4.88103024191609

! --- elements
QF: QUADRUPOLE, L=0.3, K1=0.6
D1: DRIFT, L=0.5
B1: SBEND, L=1, ANGLE=0.1, E1=0.05, E2=0.05, FINT=0.5, HGAP=0.02
D2: DRIFT, L=0.5
SOL: SOLENOID, L=0.4, KS=0.3
SX: SEXTUPOLE, L=0.2, K2=1.5
OC: OCTUPOLE, L=0.2, K3=2.5
MP: MULTIPOLE, K1L=0.1, T1=0.785398163397448, K2L=0.4
CAV: RFCAVITY, L=0, VOLT=1, LAG=0.166666666666667, FREQ=325
COR: KICKER, L=0.05, HKICK=0.001, VKICK=-0.002
COLL: RCOLLIMATOR, L=0.1, XSIZE=0.02, YSIZE=0.03
BPM1: MONITOR, L=0
FM: DRIFT, L=0.3
NC: DRIFT, L=0.4
RQ: DRIFT, L=0.1
FOIL: MARKER
TAY: MARKER
PA: MARKER
RC: MARKER
! lattix directive: LATTICE 4 0
! lattix directive: LATTICE_END
BV: RBEND, L=1.05, ANGLE=0.0416, TILT=-1.5707963267949
END: MARKER

! --- lines
DEMO: LINE=(QF, D1, B1, D2, SOL, SX, OC, MP, CAV, COR, COLL, BPM1, FM, NC, RQ,&
FOIL, TAY, PA, RC, BV, END)

USE, DEMO
RETURN
