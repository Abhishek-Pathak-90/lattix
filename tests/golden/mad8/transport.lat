! lattix <version> from madx
TITLE, "HELIX MAD-X demo - mixed transport line"

BEAM, PARTICLE=PROTON, MASS=0.93827208816, CHARGE=1, ENERGY=1.738272

! --- parameters
BRHO := 4.88102989258565
LQUAD := 0.25
KQUAD := 0.5
LCAV := 0.4
ABEND := 0.08

! --- elements
DRIFT_0: DRIFT, L=0.375
QF: QUADRUPOLE, L=0.25, K1=0.5
DRIFT_1: DRIFT, L=0.975
BS: SBEND, L=0.8, ANGLE=0.08, E1=0.04, E2=0.04
DRIFT_2: DRIFT, L=0.6
BPM: MONITOR, L=0
DRIFT_3: DRIFT, L=0.875
QD: QUADRUPOLE, L=0.25, K1=-0.5
DRIFT_4: DRIFT, L=1.275
SF: SEXTUPOLE, L=0.2, K2=2
DRIFT_5: DRIFT, L=1.2
CAV: RFCAVITY, L=0.4, VOLT=1.5, LAG=0, FREQ=325
DRIFT_6: DRIFT, L=1.39989331341886
BR: RBEND, L=0.800213373162275, ANGLE=0.08
DRIFT_7: DRIFT, L=1.09989331341886
OCT: MULTIPOLE, K3L=0.5
DRIFT_8: DRIFT, L=1.5
END_MARK: MARKER

! --- lines
TLINE: LINE=(DRIFT_0, QF, DRIFT_1, BS, DRIFT_2, BPM, DRIFT_3, QD, DRIFT_4, SF,&
DRIFT_5, CAV, DRIFT_6, BR, DRIFT_7, OCT, DRIFT_8, END_MARK)

USE, TLINE
RETURN
