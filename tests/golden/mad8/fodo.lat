! lattix <version> from madx
! lattix: energy_mode=delta
TITLE, "HELIX MAD-X demo - FODO cell"

BEAM, PARTICLE=PROTON, MASS=0.93827208816, CHARGE=1, ENERGY=1.738272

! --- parameters
BRHO := 4.88102989258565
LQUAD := 0.3
KFOCUS := 0.6
LBEND := 1
ABEND := 0.1
EHALF := 0.05

! --- elements
QF: QUADRUPOLE, L=0.3, K1=0.6
DRIFT_0: DRIFT, L=0.7
B1: SBEND, L=1, ANGLE=0.1, E1=0.05, E2=0.05
DRIFT_1: DRIFT, L=1
QD: QUADRUPOLE, L=0.3, K1=-0.6
DRIFT_2: DRIFT, L=1
DRIFT_3: DRIFT, L=1.3
M1: MARKER

! --- lines
FODO: LINE=(QF, DRIFT_0, B1, DRIFT_1, QD, DRIFT_2, B1, DRIFT_3, M1)

USE, FODO
RETURN
