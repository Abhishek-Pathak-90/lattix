! lattix <version> from IR
! lattix: reference species="proton" mass_eV=938272088.16 charge=1 kinetic_energy_eV=800000000

! --- variables
% 0.3 sto LQ

! --- elements
QF: KQUAD, L=0.3, K1=0.6
DR: DRIF, L=0.5
MK: MARK

! --- beam lines
CELL: LINE=(QF, 3*DR, MK)
RING: LINE=(CELL, -CELL, 2*CELL)

USE, RING
