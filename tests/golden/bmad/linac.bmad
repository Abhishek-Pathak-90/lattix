! lattix <version> from IR

parameter[particle] = proton
parameter[e_tot] = 940372088.16
parameter[geometry] = open

! --- elements
q1: quadrupole, l = 0.1, k1 = 5
da1: drift, l = 0.2
cav1: lcavity, l = 0, voltage = 300000, phi0 = -0.0833333333333333, rf_frequency = 162500000, cavity_type = traveling_wave
db1: drift, l = 0.2
q2: quadrupole, l = 0.1, k1 = -4.71640752547624
da2: drift, l = 0.2
cav2: lcavity, l = 0, voltage = 300000, phi0 = -0.0833333333333333, rf_frequency = 162500000, cavity_type = traveling_wave
db2: drift, l = 0.2
q3: quadrupole, l = 0.1, k1 = 4.47611096922601
da3: drift, l = 0.2
cav3: lcavity, l = 0, voltage = 300000, phi0 = -0.0833333333333333, rf_frequency = 162500000, cavity_type = traveling_wave
db3: drift, l = 0.2

! --- line
linac: line = (q1, da1, cav1, db1, q2, da2, cav2, db2, q3, da3, cav3, db3)

use, linac
