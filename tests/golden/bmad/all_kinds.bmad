! lattix <version> from IR

parameter[particle] = proton
parameter[e_tot] = 1038272088.16
parameter[geometry] = open

! --- elements
dr: drift, l = 0.4
qp: quadrupole, l = 0.3, k1 = 0.6, tilt = 0.02
sx: sextupole, l = 0.2, k2 = 1.5
oc: octupole, l = 0.2, k3 = 2.5
mp: multipole, k0l = 0.01, k1sl = 0.03, k2l = 0.3, k0l_status = straight_reference
bd: sbend, l = 1, angle = 0.1, e1 = 0.02, e2 = 0.03, fint = 0.45, fintx = 0.5, hgap = 0.03, ref_tilt = 0.1
sl: solenoid, l = 0.4, ks = 0.3
cv: lcavity, l = 0.5, voltage = 2000000, phi0 = -0.0833333333333333, rf_frequency = 325000000, n_cell = 5
fm: lcavity, l = 0.6, voltage = 1732050.80756888, phi0 = -0.0833333333333333, rf_frequency = 325000000
nc: drift, l = 0.7
rq: drift, l = 0.05
kk: kicker, l = 0.1, hkick = 0.001, vkick = -0.002
cl: ecollimator, l = 0.1, x1_limit = 0.02, x2_limit = 0.02, y1_limit = 0.03, y2_limit = 0.03
mk: marker
bp: monitor, l = 0.05
fl: foil, material_type = "C", area_density = 0.237
ty: taylor, l = 0.2, {1: 0.5|2}, {5: 0.001|}
pt: patch, x_offset = 0.001, y_pitch = 0.002, tilt = 0.3
rc: marker
! lattix directive (tracewin matching): ADJUST 1 2
sup_child: drift, l = 0.2

! --- line
sp: line = (sup_child)
allkinds: line = (dr, qp, sx, oc, mp, bd, sl, cv, fm, nc, rq, kk, cl, mk, bp, fl, ty, pt, rc, sp)

use, allkinds
