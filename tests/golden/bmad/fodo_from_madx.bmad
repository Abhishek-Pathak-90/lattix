! lattix <version> from madx
title, "HELIX MAD-X demo - FODO cell"

parameter[particle] = proton
parameter[e_tot] = 1738272000
parameter[geometry] = open

! --- variables
lquad = 0.3
kfocus = 0.6
lbend = 1
abend = 0.1
ehalf = 0.05

! --- elements
qf: quadrupole, l = 0.3, k1 = 0.6
drift_0: drift, l = 0.7
b1: sbend, l = 1, angle = 0.1, e1 = 0.05, e2 = 0.05
drift_1: drift, l = 1
qd: quadrupole, l = 0.3, k1 = -0.6
drift_2: drift, l = 1
drift_3: drift, l = 1.3
m1: marker

! --- line
fodo: line = (qf, drift_0, b1, drift_1, qd, drift_2, b1, drift_3, m1)

use, fodo
