###############################################################################
# lattix <version> from <fmt>
# Particle Beam(s)
###############################################################################
beam.npart = 10000
beam.units = static
beam.kin_energy = 799.99991184
beam.charge = 1e-09
beam.particle = proton
beam.distribution = waterbag
beam.lambdaX = 0.0001
beam.lambdaY = 0.0001
beam.lambdaT = 0.0001
beam.lambdaPx = 0.0001
beam.lambdaPy = 0.0001
beam.lambdaPt = 0.0001

###############################################################################
# Beamline: lattice elements and segments
###############################################################################
lattice.elements = qf drift_0 b1_e1 b1 b1_e2 drift_1 qd drift_2 b1_e1 b1 b1_e2 drift_3 m1
lattice.nslice = 1

qf.type = quad
qf.ds = 0.3
qf.k = 0.6
qf.nslice = 1

drift_0.type = drift
drift_0.ds = 0.7
drift_0.nslice = 1

b1_e1.type = dipedge
b1_e1.psi = 0.05
b1_e1.rc = 10
b1_e1.g = 0
b1_e1.K2 = 0
b1_e1.location = entry

b1.type = sbend
b1.ds = 1
b1.rc = 10
b1.nslice = 1

b1_e2.type = dipedge
b1_e2.psi = 0.05
b1_e2.rc = 10
b1_e2.g = 0
b1_e2.K2 = 0
b1_e2.location = exit

drift_1.type = drift
drift_1.ds = 1
drift_1.nslice = 1

qd.type = quad
qd.ds = 0.3
qd.k = -0.6
qd.nslice = 1

drift_2.type = drift
drift_2.ds = 1
drift_2.nslice = 1

drift_3.type = drift
drift_3.ds = 1.3
drift_3.nslice = 1

m1.type = drift
m1.ds = 0
m1.nslice = 1

###############################################################################
# Algorithms
###############################################################################
algo.space_charge = false
