; DTL-like section with RF gaps and quadrupole focusing
; 3 MeV proton beam accelerated through 8 gaps
;
TITLE DTL Section (3-7 MeV)
FREQ 352.21
;
; Solenoid LEBT section
SOLENOID 100.0 0.3 25.0 20
DRIFT 50.0 25.0 5
SOLENOID 100.0 0.3 25.0 20
DRIFT 50.0 25.0 5
;
; DTL cells: QUAD - GAP - DRIFT pattern
; Cell 1
QUAD 30.0 8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 2
QUAD 30.0 -8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 3
QUAD 30.0 8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 4
QUAD 30.0 -8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 5
QUAD 30.0 8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 6
QUAD 30.0 -8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 7
QUAD 30.0 8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
; Cell 8
QUAD 30.0 -8.0 15.0 10
DRIFT 20.0 15.0 5
GAP 577000 -30.0 15.0
DRIFT 20.0 15.0 5
;
DIAG_PHASE 1
END
